---
interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
}
const {
  title,
  description = "AJ Car Detailing, mobile expert auto detailing in Ashburn, Virginia.",
  transparentHeader = false,
} = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/form.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/png" href="/detailing/images/aj-car-detailing-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header transparent={transparentHeader} />
    <slot />
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
