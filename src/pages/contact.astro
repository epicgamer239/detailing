---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/inline-contact-.css';
---

<BaseLayout
  title={"Contact | Cody's Auto Detailing | Mobile Detailing Hanover, Ontario"}
  description={"Call, text, email or send a message to Cody's Auto Detailing. Same-day replies."}
  transparentHeader={true}
>
  
  <main id="main">
   <section class="page-hero" aria-label="Contact hero"> <div class="page-hero__veil"></div> <div class="container page-hero__inner"> <span class="eyebrow eyebrow--on-dark">Contact</span> <h2 class="page-hero__title">Talk To Cody.</h2> <p class="page-hero__lead">Call, text, email or send a message. We respond the same day and bookings usually open within the week.</p> </div> </section>  <section class="section contact-page"> <div class="container contact-page__layout"> <div class="contact-page__info" data-reveal> <span class="eyebrow">Get In Touch</span> <h3>Mobile Across Bruce and Grey County</h3> <ul class="contact-page__list"> <li> <span class="contact-page__label">Call or Text</span> <a href="tel:+15194771744" class="contact-page__value">(519) 477-1744</a> </li> <li> <span class="contact-page__label">Email</span> <a href="mailto:codycarter007@icloud.com" class="contact__value">codycarter007@icloud.com</a> </li> <li> <span class="contact-page__label">Service Area</span> <span class="contact-page__value contact-page__value--sm">Hanover, Walkerton, Chesley, Paisley, Port Elgin and surrounding Bruce and Grey County, Ontario</span> </li> <li> <span class="contact-page__label">Hours</span> <span class="contact-page__value contact-page__value--sm">
Monday to Friday: 8 AM to 6 PM<br>
Saturday: 9 AM to 3 PM<br>
Sunday: by appointment
</span> </li> </ul> <a href="/services#book" class="btn btn--outline-dark">Book Online Instead <span class="btn__arrow">&rarr;</span></a> </div> <div class="contact-page__form-wrap" data-reveal="right"> <div class="contact-form-wrapper"> <form class="contact-form" action="https://formspree.io/f/mpqebego" method="POST"> <input type="hidden" name="_subject" value="New Cody's Auto Detailing Website Lead"> <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off"> <div class="form-group"> <label class="form-label" for="name">Name <span class="form-required" aria-hidden="true">*</span></label> <input type="text" id="name" name="name" class="form-input" placeholder="Your full name" required aria-required="true" autocomplete="name"> </div> <div class="form-row"> <div class="form-group"> <label class="form-label" for="email">Email <span class="form-required" aria-hidden="true">*</span></label> <input type="email" id="email" name="email" class="form-input" placeholder="you@email.com" required aria-required="true" autocomplete="email"> </div> <div class="form-group"> <label class="form-label" for="phone">Phone</label> <input type="tel" id="phone" name="phone" class="form-input" placeholder="(519) 555 1234" autocomplete="tel"> </div> </div> <div class="form-group"> <label class="form-label" for="vehicle">Vehicle</label> <input type="text" id="vehicle" name="vehicle" class="form-input" placeholder="Year, make and model" autocomplete="off"> </div> <div class="form-group"> <label class="form-label" for="service">Service</label> <select id="service" name="service" class="form-select"> <option value="" disabled selected>Pick a service</option> <option value="Interior Detailing">Interior Detailing</option> <option value="Exterior Detailing">Exterior Detailing</option> <option value="Full Detail">Full Detail</option> <option value="Paint Correction">Paint Correction</option> <option value="Ceramic Coating">Ceramic Coating</option> <option value="Not sure yet">Not sure yet</option> </select> </div> <div class="form-group"> <label class="form-label" for="message">Details</label> <textarea id="message" name="message" class="form-input" rows="4" placeholder="Tell us about your vehicle and what you would like done"></textarea> </div> <button type="submit" class="contact-form__submit"> <span class="contact-form__submit-text">Send Request</span> <span class="contact-form__submit-sending">Sending</span> </button> <p class="contact-form__small">Or text photos of your vehicle straight to <a href="tel:+15194771744">(519) 477-1744</a> for the fastest quote.</p> </form> <div class="contact-form__success" style="display:none" role="status" aria-live="polite"> <div class="contact-form__message contact-form__message--success"> <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"> <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path> <polyline points="22 4 12 14.01 9 11.01"></polyline> </svg> <p>Request received. Cody will be in touch shortly to confirm timing and quote.</p> </div> </div> <div class="contact-form__error" style="display:none" role="alert" aria-live="assertive"> <div class="contact-form__message contact-form__message--error"> <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"> <circle cx="12" cy="12" r="10"></circle> <line x1="15" y1="9" x2="9" y2="15"></line> <line x1="9" y1="9" x2="15" y2="15"></line> </svg> <p>Something went wrong. Call or text (519) 477-1744 and we will get back to you fast.</p> <button type="button" class="contact-form__retry">Try Again</button> </div> </div> </div>   </div> </div> </section>  <section class="contact-map" aria-label="Map"> <iframe src="https://www.google.com/maps?q=Cody's%20Auto%20Detailing%2C%20Hanover%2C%20Ontario&output=embed" title="Map of Cody's Auto Detailing service area" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe> </section>  <section class="cta-band"> <div class="container cta-band__inner"> <h3 class="cta-band__title">Ready To Get Detailed?</h3> <div class="cta-band__buttons"> <a href="tel:+15194771744" class="btn btn--accent btn--large">Call (519) 477-1744</a> <a href="/services#book" class="btn btn--ghost btn--large">Book Online</a> </div> </div> </section>  
  </main>
</BaseLayout>
