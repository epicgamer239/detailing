---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/inline-service-area-.css';
---

<BaseLayout
  title={"Service Area | Mobile Auto Detailing Across Bruce and Grey County | Cody's Auto Detailing"}
  description={'Fully mobile across Bruce and Grey County, Ontario — Hanover, Walkerton, Chesley, Paisley, Port Elgin and nearby.'}
  transparentHeader={true}
>
  
  <main id="main">
  <section class="page-hero" aria-label="Service area hero"> <div class="page-hero__veil"></div> <div class="container page-hero__inner"> <span class="eyebrow eyebrow--on-dark">Service Area</span> <h2 class="page-hero__title">Where We Detail.</h2> <p class="page-hero__lead">Fully mobile across Bruce and Grey County, Ontario. Pick your town to see what we cover, or call us if you are nearby and we will let you know.</p> </div> </section> <section class="section sa-grid"> <div class="container"> <div class="section-head" data-reveal> <span class="eyebrow">Towns We Serve</span> <h2>Hanover to Port Elgin.</h2> <p class="section-head__lead">We come to your driveway. Same standard, same hand work, same products, wherever you are on our route.</p> </div> <div class="sa-grid__items" data-stagger="100"> <a href="/service-area/hanover" class="sa-card" data-reveal> <span class="sa-card__num">01</span> <h3 class="sa-card__title">Hanover</h3> <p class="sa-card__blurb">Hanover is our home base in Grey County.</p> <span class="sa-card__cta">See Detailing in Hanover <span class="btn__arrow">&rarr;</span></span> </a><a href="/service-area/walkerton" class="sa-card" data-reveal> <span class="sa-card__num">02</span> <h3 class="sa-card__title">Walkerton</h3> <p class="sa-card__blurb">We service Walkerton vehicles weekly, both on residential streets and at the local businesses.</p> <span class="sa-card__cta">See Detailing in Walkerton <span class="btn__arrow">&rarr;</span></span> </a><a href="/service-area/chesley" class="sa-card" data-reveal> <span class="sa-card__num">03</span> <h3 class="sa-card__title">Chesley</h3> <p class="sa-card__blurb">Chesley sits a short drive north of Hanover and is a regular stop on our route.</p> <span class="sa-card__cta">See Detailing in Chesley <span class="btn__arrow">&rarr;</span></span> </a><a href="/service-area/paisley" class="sa-card" data-reveal> <span class="sa-card__num">04</span> <h3 class="sa-card__title">Paisley</h3> <p class="sa-card__blurb">Paisley customers get the same hand wash and hand polish work we put into every vehicle.</p> <span class="sa-card__cta">See Detailing in Paisley <span class="btn__arrow">&rarr;</span></span> </a><a href="/service-area/port-elgin" class="sa-card" data-reveal> <span class="sa-card__num">05</span> <h3 class="sa-card__title">Port Elgin</h3> <p class="sa-card__blurb">Port Elgin is the western edge of our regular service area along Lake Huron.</p> <span class="sa-card__cta">See Detailing in Port Elgin <span class="btn__arrow">&rarr;</span></span> </a> </div> </div> </section> <section class="cta-band"> <div class="container cta-band__inner"> <h3 class="cta-band__title">Don't See Your Town?</h3> <p class="cta-band__sub">Reach out anyway. If you are within range of our normal route we will come to you.</p> <div class="cta-band__buttons"> <a href="tel:+15194771744" class="btn btn--accent btn--large">Call (519) 477-1744</a> <a href="/contact" class="btn btn--ghost btn--large">Send a Message</a> </div> </div> </section>  
  </main>
</BaseLayout>
