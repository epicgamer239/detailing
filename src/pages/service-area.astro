---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/inline-service-area-.css';
---

<BaseLayout
  title={"Service Area | Mobile Auto Detailing Across Loudoun County | AJ Car Detailing"}
  description={'Fully mobile across Loudoun County, Virginia — Ashburn, Leesburg, Sterling, Herndon and Reston and nearby.'}
  transparentHeader={true}
>
  
  <main id="main">
  <section class="page-hero" aria-label="Service area hero"> <div class="page-hero__veil"></div> <div class="container page-hero__inner"> <span class="eyebrow eyebrow--on-dark">Service Area</span> <h2 class="page-hero__title">Where We Detail.</h2> <p class="page-hero__lead">Fully mobile across Ashburn, Leesburg, Sterling, Herndon and Reston. Pick your town to see what we cover, or call us if you are nearby and we will let you know.</p> </div> </section> <section class="section sa-grid"> <div class="container"> <div class="section-head" data-reveal> <span class="eyebrow">Towns We Serve</span> <h2>Ashburn to Reston.</h2> <p class="section-head__lead">We come to your driveway. Same standard, same hand work, same products, wherever you are on our route.</p> </div> <div class="sa-grid__items" data-stagger="100"> <a href="/detailing/service-area/ashburn" class="sa-card" data-reveal> <span class="sa-card__num">01</span> <h3 class="sa-card__title">Ashburn</h3> <p class="sa-card__blurb">Ashburn is our home base in Loudoun County.</p> <span class="sa-card__cta">See Detailing in Ashburn <span class="btn__arrow">&rarr;</span></span> </a> <a href="/detailing/service-area/leesburg" class="sa-card" data-reveal> <span class="sa-card__num">02</span> <h3 class="sa-card__title">Leesburg</h3> <p class="sa-card__blurb">We service Leesburg vehicles regularly, both on residential streets and at local businesses.</p> <span class="sa-card__cta">See Detailing in Leesburg <span class="btn__arrow">&rarr;</span></span> </a> <a href="/detailing/service-area/sterling" class="sa-card" data-reveal> <span class="sa-card__num">03</span> <h3 class="sa-card__title">Sterling</h3> <p class="sa-card__blurb">Sterling sits a short drive from Ashburn and is a regular stop on our route.</p> <span class="sa-card__cta">See Detailing in Sterling <span class="btn__arrow">&rarr;</span></span> </a> <a href="/detailing/service-area/herndon" class="sa-card" data-reveal> <span class="sa-card__num">04</span> <h3 class="sa-card__title">Herndon</h3> <p class="sa-card__blurb">Herndon customers get the same hand wash and hand polish work we put into every vehicle.</p> <span class="sa-card__cta">See Detailing in Herndon <span class="btn__arrow">&rarr;</span></span> </a> <a href="/detailing/service-area/reston" class="sa-card" data-reveal> <span class="sa-card__num">05</span> <h3 class="sa-card__title">Reston</h3> <p class="sa-card__blurb">Reston is on our regular service route in the Dulles corridor.</p> <span class="sa-card__cta">See Detailing in Reston <span class="btn__arrow">&rarr;</span></span> </a> </div> </div> </section> <section class="cta-band"> <div class="container cta-band__inner"> <h3 class="cta-band__title">Don't See Your Town?</h3> <p class="cta-band__sub">Reach out anyway. If you are within range of our normal route we will come to you.</p> <div class="cta-band__buttons"> <a href="tel:+17039361803" class="btn btn--accent btn--large">Call (703) 936-1803</a> <a href="/detailing/contact" class="btn btn--ghost btn--large">Send a Message</a> </div> </div> </section>  
  </main>
</BaseLayout>
