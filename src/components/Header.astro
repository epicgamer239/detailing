---
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const headerClass = transparent
  ? 'site-header site-header--transparent'
  : 'site-header';
---
<header class={headerClass} id="site-header">
  <div class="header__inner">
    <a href="/detailing/" class="header__logo" aria-label="AJ Car Detailing Home">
      <img src="/detailing/images/aj-car-detailing-logo.png" alt="AJ Car Detailing Logo" width="180" height="64" />
    </a>
    <nav class="header__nav" aria-label="Primary">
      <a href="/detailing/" class="header__link">Home</a>
      <a href="/detailing/about" class="header__link">About</a>
      <a href="/detailing/services" class="header__link">Services</a>
      <a href="/detailing/service-area" class="header__link">Service Area</a>
      <a href="/detailing/contact" class="header__link">Contact</a>
    </nav>
    <div class="header__actions">
      <a href="tel:+17039361803" class="header__phone">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path></svg>
        (703) 936-1803
      </a>
      <a href="/detailing/services#book" class="btn btn--accent">Book a Detail</a>
    </div>
    <button class="header__burger" id="burger" aria-label="Toggle menu" aria-expanded="false">
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <a href="/detailing/" class="mobile-menu__link">Home</a>
    <a href="/detailing/about" class="mobile-menu__link">About</a>
    <a href="/detailing/services" class="mobile-menu__link">Services</a>
    <a href="/detailing/service-area" class="mobile-menu__link">Service Area</a>
    <a href="/detailing/contact" class="mobile-menu__link">Contact</a>
    <a href="/detailing/services#book" class="btn btn--accent btn--large btn--full mobile-menu__cta">Book a Detail</a>
    <div class="mobile-menu__contact">
      <a href="tel:+17039361803" class="mobile-menu__phone">(703) 936-1803</a>
      <a href="mailto:ajcardetailz@gmail.com" class="mobile-menu__email">ajcardetailz@gmail.com</a>
    </div>
  </div>
</div>
